# ── Google Gemini (free tier — get key at aistudio.google.com/apikey) ────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Anthropic Claude (optional — console.anthropic.com/billing) ──────────────
ANTHROPIC_API_KEY=

# ── Groq (free tier — console.groq.com) ──────────────────────────────────────
GROQ_API_KEY=

# ── xAI Grok (console.x.ai) ─────────────────────────────────────────────────
XAI_API_KEY=

# ── OpenAI (optional) ───────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── ElevenLabs TTS (optional — voice responses) ─────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ── Tavily Web Search (optional — enables richer web search) ─────────────────
TAVILY_API_KEY=

# ── Whisper STT model (runs locally in browser) ────────────────────────────
# Options: tiny | base | small | medium | large-v3
#   tiny    (~39MB)   — fastest, least accurate
#   base    (~145MB)  — good balance (default)
#   small   (~466MB)  — better accuracy
#   medium  (~1.5GB)  — high accuracy, slower
#   large-v3 (~3GB)   — best accuracy, heavy
WHISPER_MODEL=base

# ── Active LLM backend: gemini | groq | xai | anthropic ─────────────────────
LLM_BACKEND=gemini
